---
// src/components/Footer.astro
// Light gold background · black / deep brown / gold text
// Lang-aware: pass lang="zh" for the Chinese site.
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props
const zh = lang === 'zh'
const P = (en: string) => (zh ? '/zh' + en : en)   // path prefixer

const T = {
  desc: zh
    ? '丰麒集团是一家连接中国与东南亚的跨境产业集团，业务涵盖农业、物流、产业园区、贸易与数字系统。'
    : 'A cross-border industrial group connecting China and Southeast Asia through agriculture, logistics, industrial parks, trade and digital systems.',
  business:   zh ? '业务板块' : 'Business',
  projects:   zh ? '旗舰项目' : 'Projects',
  company:    zh ? '集团信息' : 'Company',
  offices:    zh ? '全球办事处' : 'Global Offices',
  contact:    zh ? '联系我们' : 'Contact',
  related:    zh ? '关联平台' : 'Related',
  // Business segment labels
  bizParks:      zh ? '产业园区' : 'Industrial Parks',
  bizLogistics:  zh ? '物流与供应链' : 'Logistics & Supply Chain',
  bizHealth:     zh ? '医疗与康养' : 'Healthcare & Wellness',
  bizTrade:      zh ? '贸易与分销' : 'Trade & Distribution',
  bizAgri:       zh ? '农业与生态科技' : 'Agriculture & Eco-Tech',
  bizDigital:    zh ? '数字系统' : 'Digital Systems',
  // Project labels
  prjKuantan:  zh ? '关丹清真产业园' : 'Kuantan Halal Park',
  prjFengjie:  zh ? '丰捷物流' : 'Fengjie Logistics',
  prjZeng:     zh ? '增城生态空间' : 'Zengcheng Eco Space',
  prjBroiler:  zh ? '农业用地 — 马来西亚' : 'Agricultural Land — Malaysia',
  prjAchiev:   zh ? '天下人物' : 'Achievers World',
  // Company labels
  cmpAbout:       zh ? '关于丰麒' : 'About Fengqi',
  cmpLeadership:  zh ? '领导团队' : 'Leadership',
  cmpInsights:    zh ? '动态资讯' : 'Insights',
  cmpPartnership: zh ? '合作伙伴' : 'Partnership',
  cmpContact:     zh ? '联系我们' : 'Contact',
  // Offices
  // Offices — grouped by country
  offChinaLabel: zh ? '中国办事处' : 'China Offices',
  offChinaCities: zh
    ? '广州｜深圳｜北京｜保定｜成都｜厦门｜抚州'
    : 'Guangzhou | Shenzhen | Beijing | Baoding | Chengdu | Xiamen | Fuzhou',
  offMyLabel: zh ? '马来西亚' : 'Malaysia',
  offMyCities: zh ? '吉隆坡｜关丹' : 'Kuala Lumpur | Kuantan',
  // Related platform display names
  relAsean:      zh ? '东盟 ASEAN 平台'      : 'ASEAN Platform',
  relAseanChina: zh ? '东盟 ASEAN-中国区平台' : 'ASEAN-China Platform',
  copy:   zh ? '© 2025 丰麒集团有限公司' : '© 2025 Fengqi Group Limited',
}
---
<footer id="site-footer">
  <div class="ft-top">
    <div class="wrap ft-top-inner">

      <!-- Brand -->
      <div class="ft-brand">
        <a href={P('/')} class="ft-logo" aria-label="Fengqi Group">
          <img src="/images/logo/logo-circle.png" alt="Fengqi" class="ft-logo-img" />
          <div>
            <div class="ft-logo-name">FENGQI GROUP</div>
            <span class="ft-logo-cn">丰麒集团有限公司</span>
          </div>
        </a>
        <p class="ft-desc">{T.desc}</p>
        <p class="ft-motto">丰行天下 · 麒通四海</p>
      </div>

      <!-- Business -->
      <div>
        <p class="ft-col-title">{T.business}</p>
        <nav class="ft-links">
          <a href={P('/business') + '#parks'}>{T.bizParks}</a>
          <a href={P('/business') + '#logistics'}>{T.bizLogistics}</a>
          <a href={P('/business') + '#healthcare'}>{T.bizHealth}</a>
          <a href={P('/business') + '#trade'}>{T.bizTrade}</a>
          <a href={P('/business') + '#agriculture'}>{T.bizAgri}</a>
          <a href={P('/business') + '#digital'}>{T.bizDigital}</a>
        </nav>
      </div>

      <!-- Projects + Company -->
      <div>
        <p class="ft-col-title">{T.projects}</p>
        <nav class="ft-links">
          <a href={P('/projects/kuantan-halal-park')}>{T.prjKuantan}</a>
          <a href={P('/projects/indonesia-fengjie-logistics')}>{T.prjFengjie}</a>
          <a href={P('/projects/zengcheng-ecological-space')}>{T.prjZeng}</a>
          <a href={P('/projects/broiler-chicken-malaysia')}>{T.prjBroiler}</a>
          <a href={P('/projects/achievers-world')}>{T.prjAchiev}</a>
        </nav>
        <p class="ft-col-title" style="margin-top:28px">{T.company}</p>
        <nav class="ft-links">
          <a href={P('/about')}>{T.cmpAbout}</a>
          <a href={P('/about') + '#team'}>{T.cmpLeadership}</a>
          <a href={P('/insights')}>{T.cmpInsights}</a>
          <a href={P('/partnership')}>{T.cmpPartnership}</a>
          <a href={P('/contact')}>{T.cmpContact}</a>
        </nav>
      </div>

      <!-- Offices -->
      <div>
        <p class="ft-col-title">{T.offices}</p>
        <div class="ft-office-group">
          <p class="ft-office-country">{T.offChinaLabel}</p>
          <p class="ft-office-cities">{T.offChinaCities}</p>
        </div>
        <div class="ft-office-group">
          <p class="ft-office-country">{T.offMyLabel}</p>
          <p class="ft-office-cities">{T.offMyCities}</p>
        </div>
        <div class="ft-contact">
          <p class="ft-col-title" style="margin-top:28px">{T.contact}</p>
          <a href="mailto:info@fengqi-global.com" class="ft-email">info@fengqi-global.com</a>
        </div>
        <div class="ft-related">
          <p class="ft-col-title" style="margin-top:28px">{T.related}</p>
          <nav class="ft-links">
            <a href="https://www.arff.my" target="_blank" rel="noopener noreferrer">{T.relAsean}</a>
            <a href="https://zy30719374-2.jzfkw.net/" target="_blank" rel="noopener noreferrer">{T.relAseanChina}</a>
          </nav>
        </div>
      </div>

    </div>
  </div>

  <div class="ft-bottom">
    <div class="wrap ft-bottom-inner">
      <span class="ft-copy">{T.copy}</span>
    </div>
  </div>
</footer>


<style>
/* ── Light gold palette for footer ── */
:root {
  --ft-bg:       #EDE9E0;   /* warm tan — matches FeatureSlider --bg-3 */
  --ft-bg-2:     #E2DDD4;   /* slightly deeper — matches --bg-4 */
  --ft-border:   rgba(139,109,60,.22);
  --ft-text:     #1A1814;   /* near-black — strong contrast */
  --ft-text-2:   #3A3028;   /* dark brown body */
  --ft-text-3:   #6B5832;   /* mid-brown muted */
  --ft-gold:     #7A5A14;   /* deep gold on tan bg — readable */
}

#site-footer { background: var(--ft-bg); border-top: 2px solid var(--ft-border); }

.ft-top { padding: 64px 0 52px; }
.ft-top-inner {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr;
  gap: 52px;
}

/* Brand */
.ft-logo { display:flex; align-items:center; gap:16px; text-decoration:none; margin-bottom:20px; }
.ft-logo-img { width:52px; height:52px; object-fit:contain; }
.ft-logo-name { font-family:var(--FL); font-size:17px; color:var(--ft-text); letter-spacing:3px; font-weight:600; }
.ft-logo-cn   { font-family:var(--FD); font-size:18px; color:var(--ft-gold); letter-spacing:2px; display:block; margin-top:4px; font-style:italic; }
.ft-desc  { font-family:var(--FB); font-size:16px; color:var(--ft-text-2); line-height:1.85; margin-bottom:16px; }
.ft-motto { font-family:var(--FD); font-size:22px; font-style:italic; color:var(--ft-gold); letter-spacing:2px; margin-bottom:18px; }


/* Column titles */
.ft-col-title {
  font-family:var(--FL); font-size:14px; letter-spacing:2px;
  color:var(--ft-text); margin-bottom:14px; padding-bottom:10px;
  border-bottom:1.5px solid var(--ft-border); font-weight:600;
}

/* Links */
.ft-links { display:flex; flex-direction:column; }
.ft-links a {
  font-family:var(--FB); font-size:15px; color:var(--ft-text-2);
  padding:6px 0; transition:color .25s; line-height:1.5;
  border-bottom:1px solid rgba(184,145,42,.12);
}
.ft-links a:hover { color:var(--ft-gold); }

/* Office groups — country + city list */
.ft-office-group { margin-bottom:16px; }
.ft-office-country {
  font-family:var(--FB); font-size:15px; font-weight:600;
  color:var(--ft-text); margin-bottom:4px; line-height:1.4;
}
.ft-office-cities {
  font-family:var(--FB); font-size:14px; color:var(--ft-text-2);
  line-height:1.7;
}

/* Contact email */
.ft-email {
  display:block; font-family:var(--FL); font-size:16px; letter-spacing:1px;
  color:var(--ft-gold); font-weight:500; margin-top:6px; text-decoration:none;
  transition:color .25s;
}
.ft-email:hover { color:var(--ft-text); }

/* Bottom bar */
.ft-bottom { background:var(--ft-bg-2); border-top:1px solid var(--ft-border); padding:20px 0; }
.ft-bottom-inner { display:flex; justify-content:center; align-items:center; }
.ft-copy { font-family:var(--FB); font-size:15px; letter-spacing:0.5px; color:var(--ft-text-3); }

@media (max-width:1100px) { .ft-top-inner { grid-template-columns:1fr 1fr; gap:36px; } }
@media (max-width:700px)  {
  .ft-top-inner { grid-template-columns:1fr; }
  .ft-bottom-inner { text-align:center; }
}
</style>
