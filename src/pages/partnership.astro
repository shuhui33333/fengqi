        </div>

        <p class="dl-note reveal d3">
          To request specific materials not listed above, please contact us at
          <a href="mailto:info@fengqi-global.com">info@fengqi-global.com</a>
        </p>
      </div>
    </section>

    <PartnerForm />

  </main>
  <Footer />
  <ClientEffects />
</BaseLayout>
<style>
.pn-hero{padding-top:calc(var(--sv) + 66px);background:var(--bg-2);border-bottom:1px solid var(--bg-4);position:relative;overflow:hidden}
.pn-geo{mask-image:radial-gradient(ellipse 80% 80% at 40% 40%,black 20%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse 80% 80% at 40% 40%,black 20%,transparent 70%)}
.pn-hero-c{max-width:760px}
.pn-types-sec{background:var(--bg-2);border-top:1px solid var(--gold-border);border-bottom:1px solid var(--gold-border);position:relative;overflow:hidden}
.pn-grid{grid-template-columns:repeat(4,1fr)}
.pn-card{background:var(--bg-2);padding:44px 28px}
.pn-card:hover{background:var(--bg-3)}
.pn-card-t{font-family:var(--FD);font-size:22px;font-weight:400;color:var(--gold);margin-bottom:6px;line-height:1.2}
.pn-card-sub{font-family:var(--FL);font-size:18px;letter-spacing:2px;color:var(--gold-dk);margin-bottom:18px;padding-bottom:16px;border-bottom:1px solid var(--gold-border)}
.pn-card-b{font-size:17px;line-height:2;color:var(--text-3);margin-bottom:20px}
.pn-card-li{list-style:none}
.pn-card-li li{font-size:18px;color:var(--text-3);padding-left:12px;position:relative;margin-bottom:8px;line-height:1.7}
.pn-card-li li::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:4px;height:1px;background:var(--gold-dk)}
.pn-why{background:var(--bg)}
.pn-why-grid{grid-template-columns:repeat(4,1fr)}
.pn-w{background:var(--bg-2);padding:40px 28px}
.pn-w:hover{background:var(--bg-3)}
.pn-w-t{font-family:var(--FD);font-size:19px;font-weight:400;color:var(--gold);margin-bottom:14px;line-height:1.25}
.pn-w-b{font-size:17px;line-height:2;color:var(--text-3)}
@media(max-width:1100px){.pn-grid,.pn-why-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.pn-grid,.pn-why-grid{grid-template-columns:1fr}}

/* Interior hero — dark text on light background */
.pn-hero { background:var(--bg-2); border-bottom:1px solid var(--bg-4); }
.pn-hero h1 { color:var(--text); }
.pn-hero h1 em { color:var(--gold); }
.pn-hero .label { color:var(--gold); }
.pn-hero .body-text { color:var(--text-2); }
.pn-hero-wrap { position:relative; z-index:2; max-width:900px; }

/* ── Download Centre ── */
.dl-sec { background: var(--bg-2); border-top: 1px solid var(--bg-4); }

.dl-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-bottom: 32px;
}

.dl-card {
  background: var(--bg);
  border: 1px solid var(--bg-4);
  border-top: 3px solid var(--gold);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  transition: box-shadow .25s, border-color .25s;
}
.dl-card:hover {
  box-shadow: var(--shadow);
  border-color: var(--gold-border);
}

.dl-card-head {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.dl-icon {
  width: 42px; height: 42px; flex-shrink: 0;
  background: var(--gold-faint); border: 1px solid var(--gold-border);
  border-radius: 2px; display: flex; align-items: center; justify-content: center;
  color: var(--gold);
}
.dl-icon svg { width: 20px; height: 20px; }

.dl-card-num {
  font-family: var(--FL); font-size: 18px; color: var(--gold);
  font-weight: 600; letter-spacing: 1px; line-height: 1; margin-bottom: 4px;
}
.dl-card-title {
  font-family: var(--FL); font-size: 16px; font-weight: 600;
  color: var(--text); line-height: 1.3; margin-bottom: 4px;
}
.dl-card-cn {
  font-family: var(--FB); font-size: 13px; color: var(--text-muted);
}

.dl-files {
  list-style: none;
  display: flex; flex-direction: column;
  gap: 2px;
  flex: 1;
}
.dl-link {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px;
  background: var(--bg-2); border: 1px solid transparent;
  text-decoration: none; color: var(--text-2);
  font-family: var(--FB); font-size: 14px;
  transition: background .2s, border-color .2s, color .2s;
  border-radius: 1px;
}
.dl-link:hover {
  background: var(--gold-faint);
  border-color: var(--gold-border);
  color: var(--text);
}
.dl-pdf {
  width: 16px; height: 16px; flex-shrink: 0; color: var(--gold); opacity: .8;
}
.dl-link span:nth-child(2) { flex: 1; }
.dl-tag {
  font-family: var(--FL); font-size: 10px; letter-spacing: 1px;
  color: var(--gold-dk); background: rgba(184,145,42,.1);
  padding: 2px 7px; border-radius: 2px; flex-shrink: 0;
}

.dl-note {
  font-family: var(--FB); font-size: 15px; color: var(--text-3);
  text-align: center; padding-top: 8px;
}
.dl-note a {
  color: var(--gold); text-decoration: underline; text-underline-offset: 3px;
}

@media (max-width: 1100px) { .dl-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 700px)  { .dl-grid { grid-template-columns: 1fr; } }

</style>
