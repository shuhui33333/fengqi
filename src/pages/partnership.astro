---
// src/pages/partnership.astro  →  /partnership
import BaseLayout    from '../layouts/BaseLayout.astro'
import Header        from '../components/Header.astro'
import Footer        from '../components/Footer.astro'
import ClientEffects from '../components/ClientEffects.astro'
import PartnerForm   from '../components/partnership/PartnerForm.astro'
---
<BaseLayout title="合作伙伴关系 / Partnership | Fengqi Group" description="Partner with Fengqi to access Southeast Asian markets, halal certification channels, logistics networks and industrial park resources.">
  <Header active="/partnership" />
  <main>

    <section class="section pn-hero page-hero">
      <div class="geo-bg pn-geo"></div>
      <div class="wrap">
        <div class="pn-hero-c">
          <div class="label">合作伙伴关系 · Partnership</div>
          <h1 class="heading">Build Together Across <em>China &amp; Southeast Asia</em>.</h1>
          <p class="body-text body-text--wide">Fengqi aims to be a long-term cooperation platform connecting the Chinese and Southeast Asian markets, assisting partners in entering regional markets more smoothly and establishing a more stable industrial and supply chain system. For us, cooperation is not just business dealings — it means genuinely helping partners solve market entry, supply chain management, logistics, regional resource connection and long-term operations challenges.</p>
        </div>
      </div>
    </section>

    <!-- Four partner types -->
    <section class="section pn-types-sec" id="partner-types">
      <div class="geo-bg" style="opacity:.3"></div>
      <div class="wrap">
        <div class="reveal">
          <div class="label">Who We Work With</div>
          <h2 class="heading">Four <em>Partnership</em> Models.</h2>
          <p class="body-text">Whether you're a government agency, enterprise, investor or channel partner — Fengqi builds long-term, stable and practically effective cooperation.</p>
        </div>
        <div class="pn-grid cgrid">
          {[
            {idx:'01',t:'Government Agencies',    sub:'Regional Industry & Project Cooperation',
             b:'As more companies enter Southeast Asian markets, local governments focus not only on attracting investment, but on long-term project viability, employment creation and complete industrial and supply chain foundations. Fengqi collaborates with government agencies, local development organisations and industrial parks to jointly promote regional industrial development, with emphasis on long-term operations, market connectivity and logistics support.',
             li:['Industrial park development & planning','Agricultural and food industry projects','Logistics, warehousing and infrastructure','China–Southeast Asia resource and market connections']},
            {idx:'02',t:'Industry Partners',       sub:'Business & Industry Collaboration',
             b:'Companies entering Southeast Asia find the real challenge is warehousing, transport, supply chain, local partnerships and market operations — not sales. Fengqi helps enterprises enter regional markets smoothly via its network across China, Malaysia and Indonesia.',
             li:['Park entry and establishment support','Supply chain setup and management','Halal certification and compliance assistance','Joint market development and distribution channels']},
            {idx:'03',t:'Investors',              sub:'Long-Term Industry Cooperation',
             b:'Fengqi focuses on projects that can operate sustainably over the long term, with stable supply chains and genuine industrial development capability. The group prioritises long-term operation and sustained growth over short-term transactions.',
             li:['Industrial park projects (Kuantan & future)','Agricultural and food industry development','Logistics and warehousing networks','Healthcare and wellness sectors']},
            {idx:'04',t:'Channel Partners',       sub:'Market & Channel Cooperation',
             b:'As the Southeast Asian market grows, demand for stable supply, logistics efficiency and local market cooperation increases. Fengqi helps channel partners build stable product supply and reduces pressure on logistics, inventory and distribution.',
             li:['Product supply and inventory management','Regional cold chain and distribution support','Halal market resource connections','Local market channels and sales networks']},
          ].map((p,i)=>(
            <div class={`pn-card ctop cbar reveal d${i+1}`}>
              <div class="cidx">{p.idx}</div>
              <h3 class="pn-card-t">{p.t}</h3>
              <p class="pn-card-sub">{p.sub}</p>
              <p class="pn-card-b">{p.b}</p>
              <ul class="pn-card-li">{p.li.map(l=><li>{l}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Fengqi -->
    <section class="section pn-why" id="why-fengqi">
      <div class="wrap">
        <div class="reveal">
          <div class="label">Why Partner With Fengqi</div>
          <h2 class="heading">More Than a Service Provider —<br />A <em>Long-Term</em> Platform Partner.</h2>
        </div>
        <div class="pn-why-grid cgrid">
          {[
            {t:'Regional Presence & Local Knowledge', b:'Long-term operation in Malaysia and Indonesia gives Fengqi deep familiarity with local business environments, government policies, regulatory frameworks and market dynamics — reducing your entry risk and time.'},
            {t:'Integrated Cross-Industry System',     b:'From industrial parks and certification to logistics, supply chain and digital management — a connected system rather than isolated services, reducing fragmentation in cross-border operations.'},
            {t:'Halal Market Connectivity',            b:"Fengqi's established relationships with Malaysia's JAKIM certification system and regional halal networks provide partners with direct access to one of the world's fastest-growing consumer segments."},
            {t:'Long-Term Operational Commitment',     b:'Fengqi emphasises stability, transparency and long-term partnerships — focused on sustained market presence and operational success, not just project completion.'},
          ].map((w,i)=>(
            <div class={`pn-w ctop cbar reveal d${i+1}`}><h3 class="pn-w-t">{w.t}</h3><p class="pn-w-b">{w.b}</p></div>
          ))}
        </div>
      </div>
    </section>


    <!-- ── Download Centre ── -->
    <section class="section dl-sec" id="download-centre">
      <div class="wrap">
        <div class="reveal">
          <div class="label">资料下载中心 · DOWNLOAD CENTRE</div>
          <h2>Corporate <em>Resources</em>.</h2>
          <p class="body-text body-text--wide">
            Download Fengqi Group's official materials — corporate introductions, investment brochures,
            product catalogues and technical solutions. All documents are available for free download.
          </p>
        </div>

        <div class="dl-grid">

          <!-- 01 Corporate Profile 集团介绍 -->
          <div class="dl-card reveal d1">
            <div class="dl-card-head">
              <div class="dl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </div>
              <div>
                <p class="dl-card-num">01</p>
                <h3 class="dl-card-title">Corporate Profile</h3>
                <p class="dl-card-cn">集团介绍下载</p>
              </div>
            </div>
            <ul class="dl-files">
              <li>
                <a href="/documents/fengqi-corporate-profile-cn.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>公司介绍（中文版）</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/fengqi-corporate-profile-en.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>Corporate Profile (English)</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/gambang-halal-park-cn.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>Gambang Halal Park 项目介绍（中文版）</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/gambang-halal-park-en.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>Gambang Halal Park Introduction (English)</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/fengqi-agritech-profile-cn.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>农业科技有限公司企业介绍（中文版）</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- 02 Investment Brochure 招商资料 -->
          <div class="dl-card reveal d2">
            <div class="dl-card-head">
              <div class="dl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <path d="M3 9h18M9 21V9"/>
                </svg>
              </div>
              <div>
                <p class="dl-card-num">02</p>
                <h3 class="dl-card-title">Investment Brochure</h3>
                <p class="dl-card-cn">招商资料下载</p>
              </div>
            </div>
            <ul class="dl-files">
              <li>
                <a href="/documents/investment-brochure-cn.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>招商资料（中文版）</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/investment-brochure-en.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>Investment Brochure (English)</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- 03 Product Catalogue 产品资料 -->
          <div class="dl-card reveal d3">
            <div class="dl-card-head">
              <div class="dl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </div>
              <div>
                <p class="dl-card-num">03</p>
                <h3 class="dl-card-title">Product Catalogue</h3>
                <p class="dl-card-cn">产品资料下载</p>
              </div>
            </div>
            <ul class="dl-files">
              <li>
                <a href="/documents/product-catalogue-cn.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>产品资料（中文版）</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/product-catalogue-en.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>Product Catalogue (English)</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- 04 Technical Solutions 技术方案 -->
          <div class="dl-card reveal d4">
            <div class="dl-card-head">
              <div class="dl-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </div>
              <div>
                <p class="dl-card-num">04</p>
                <h3 class="dl-card-title">Technical Solutions</h3>
                <p class="dl-card-cn">技术方案下载</p>
              </div>
            </div>
            <ul class="dl-files">
              <li>
                <a href="/documents/technical-solutions-cn.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>技术方案（中文版）</span>
                  <span class="dl-tag">PDF</span>
                </a>
              </li>
              <li>
                <a href="/documents/technical-solutions-en.pdf" class="dl-link" download>
                  <svg class="dl-pdf" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" clip-rule="evenodd"/></svg>
                  <span>Technical Solutions (English)</span>
                  <span class="dl-tag">PDF</span>
                </a>
