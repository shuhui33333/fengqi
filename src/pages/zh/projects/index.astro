---
// src/pages/zh/projects/index.astro  →  /zh/projects
import BaseLayout    from '../../../layouts/BaseLayout.astro'
import Header        from '../../../components/Header.astro'
import Footer        from '../../../components/Footer.astro'
import ClientEffects from '../../../components/ClientEffects.astro'
import ProjectCard   from '../../../components/shared/ProjectCard.astro'
import { getCollection } from 'astro:content'
import { ZH_PROJECTS, ZH_CATEGORY, ZH_STATUS } from '../../../lib/zh-content'

const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order)
---
<BaseLayout
  lang="zh"
  title="旗舰项目 | 丰麒集团"
  description="丰麒集团在中国、马来西亚和印度尼西亚推进的核心项目——包括彭亨清真产业园、丰捷物流、增城生态空间、现代肉鸡养殖农场及天下人物文化传媒品牌。"
>
  <Header active="/zh/projects" lang="zh" />
  <main>
    <section class="section pj-hero page-hero">
      <div class="geo-bg pj-geo"></div>
      <div class="wrap">
        <div class="label">旗舰项目</div>
        <h1 class="heading">战略落地，<em>务实推进</em>。</h1>
        <p class="body-text body-text--wide">丰麒集团在中国、马来西亚和印度尼西亚推进的核心项目——助力企业落地注册、认证通关、物流配送与市场拓展，覆盖东盟及全球市场。</p>
      </div>
    </section>
    <section class="section" id="all-projects">
      <div class="wrap">
        <div class="pj-grid cgrid">
          {projects.map(p => {
            const zh = ZH_PROJECTS[p.slug]
            return (
              <ProjectCard
                title={zh?.title ?? p.data.title}
                subtitle={zh?.subtitle ?? p.data.subtitle}
                location={zh?.location ?? p.data.location}
                status={ZH_STATUS[p.data.status] ?? p.data.status}
                highlights={zh?.highlights ?? p.data.highlights}
                category={ZH_CATEGORY[p.data.category] ?? p.data.category}
                href={`/zh/projects/${p.slug}`}
                order={p.data.order}
              />
            )
          })}
        </div>
      </div>
    </section>
  </main>
  <Footer lang="zh" />
  <ClientEffects />
</BaseLayout>
<style>
.pj-hero{padding-top:calc(var(--sv) + 66px);background:var(--bg-2);border-bottom:1px solid var(--bg-4);position:relative;overflow:hidden}
.pj-geo{mask-image:radial-gradient(ellipse 80% 80% at 40% 40%,black 20%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse 80% 80% at 40% 40%,black 20%,transparent 70%)}
.pj-grid{grid-template-columns:repeat(2,1fr)}
@media(max-width:1100px){.pj-grid{grid-template-columns:1fr}}
.pj-hero h1 { color:var(--text); }
.pj-hero h1 em { color:var(--gold); }
.pj-hero .label { color:var(--gold); }
.pj-hero .body-text { color:var(--text-2); }
</style>
