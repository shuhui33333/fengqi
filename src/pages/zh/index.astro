---
// src/pages/zh/index.astro  →  /zh/
// 中文首页 — 结构与英文首页一致，内容为中文
import BaseLayout    from '../../layouts/BaseLayout.astro'
import Header        from '../../components/Header.astro'
import Footer        from '../../components/Footer.astro'
import ClientEffects from '../../components/ClientEffects.astro'
import { getCollection } from 'astro:content'
import { getAllInsights } from '../../lib/storyblok'

const projects = (await getCollection('projects'))
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)

const ctfInsights = await getAllInsights().catch(() => [])
const latest = ctfInsights.slice(0, 3)

const DEFAULT_NEWS_IMG = 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800&q=80'

// Chinese project metadata
const ZH_PROJECTS: Record<string, { title: string; subtitle: string; highlights: string[] }> = {
  'kuantan-halal-park': {
    title:    '关丹数字清真食品产业园',
    subtitle: '马来西亚清真市场的核心战略平台',
    highlights: [
      '格宾 730 英亩 + 甘孟 100 英亩，合计 830 英亩',
      '毗邻马中关丹产业园，距关丹港约 10 公里',
      'JAKIM 清真认证：30+ 天 → 10–12 天',
      '通关时间：约 72 小时 → 约 48 小时',
      '0–5% 关税优惠（RCEP 及马来西亚-欧盟自贸协定）',
      '聚焦：清真食品、保健品、化妆品、药品',
    ],
  },
  'indonesia-fengjie-logistics': {
    title:    '丰捷物流印度尼西亚',
    subtitle: '覆盖爪哇岛的区域仓储与配送网络',
    highlights: [
      '自营 4 个仓储配送中心，遍布爪哇岛',
      '覆盖约 80% 爪哇物流需求',
      '触达约 1.45 亿人口',
      '冷链损耗率 <8%（行业均值 15%）',
      '库存周转效率提升 35%',
      '配送成本降低约 20%',
    ],
  },
}
---

<BaseLayout
  title="丰麒集团 | 跨境产业平台"
  description="丰麒集团专注农业、物流、清真产业园、贸易与数字系统，连接中国与东南亚市场。"
  lang="zh"
>
  <Header active="/zh" lang="zh" />
  <main>

    <!-- ══ 首页 Hero ══ -->
    <section class="hero" id="top">
      <div class="hero-bg"></div>

      <div class="wrap hero-content">
        <!-- 左：文案 -->
        <div class="hero-left">
          <p class="hero-over">跨境产业集团</p>

          <h1 class="hero-h1">
            连接中国<br />
            与<em>东南亚</em><br />
            共筑产业未来。
          </h1>

          <p class="hero-body">
            丰麒集团专注农业、物流、医疗与康养、贸易及数字系统——以生态农业、肉鸡养殖、仓储物流、清真产业园及供应链协同为核心，构建连接中国与东南亚的跨境产业平台。
          </p>

          <div class="hero-actions">
            <a href="/zh/business"    class="btn btn--gold">探索我们的业务</a>
            <a href="/zh/partnership" class="btn btn--ghost">与我们合作</a>
          </div>
        </div>

        <!-- 右：6 个业务板块卡片 -->
        <div class="hero-right" aria-hidden="true">
          <div class="hero-segs">
            {[
              { num:'01', name:'产业园\n跨境平台',   href:'/zh/business#parks'       },
              { num:'02', name:'物流\n供应链',       href:'/zh/business#logistics'   },
              { num:'03', name:'医疗\n与康养',       href:'/zh/business#healthcare'  },
              { num:'04', name:'贸易\n与分销',       href:'/zh/business#trade'       },
              { num:'05', name:'农业\n生态科技',     href:'/zh/business#agriculture' },
              { num:'06', name:'数字\n系统',         href:'/zh/business#digital'     },
            ].map((s, i) => (
              <a href={s.href} class={`hseg anim-d${i}`}>
                <span class="hseg-num">{s.num}</span>
                <span class="hseg-name">{s.name}</span>
                <span class="hseg-arr">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 底部亮点栏 -->
      <div class="hero-bar">
        <div class="wrap hero-bar-inner">
          {[
            { title:'中国基地',    desc:'农业科技、工业资源与供应链出口'              },
            { title:'马来西亚枢纽', desc:'830 英亩清真产业园 · JAKIM 认证通道'        },
            { title:'印度尼西亚网络', desc:'丰捷物流 · 4 个仓储中心 · 触达 1.45 亿人' },
            { title:'跨境产业平台', desc:'生产 → 供应链 → 贸易 → 市场'                 },
          ].map(item => (
            <div class="hb-item">
              <div class="hb-dot"></div>
              <div>
                <p class="hb-title">{item.title}</p>
                <p class="hb-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ 数据指标条 ══ -->
    <div class="met-bar">
      <div class="wrap met-inner">
        {[
          { num:'2014',  lbl:'成立年份'     },
          { num:'3',     lbl:'业务国家'     },
          { num:'6',     lbl:'业务板块'     },
          { num:'830ac', lbl:'关丹清真产业园' },
          { num:'145M',  lbl:'爪哇物流覆盖'  },
          { num:'80+',   lbl:'清真认证国家'  },
        ].map((m, i) => (
          <div class={`met reveal d${i}`}>
            <div class="met-num">{m.num}</div>
            <div class="met-lbl">{m.lbl}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- ══ 六大核心业务板块 ══ -->
    <section class="section biz-sec" id="business">
      <div class="wrap">
        <div class="reveal">
          <div class="label">核心业务板块</div>
          <h2>六大<em>产业</em>协同支柱</h2>
          <p class="body-text">从生产与物流，到认证支持、贸易与数字化管理——丰麒六大板块共同构成连接中国与东南亚市场的完整产业体系。</p>
        </div>
        <div class="biz-grid">

          <div class="bc cbar" onclick="location.href='/zh/business#parks'">
            <div class="bc-img"><img src="/images/common/business/b1-new.png" alt="产业园" loading="lazy" /></div>
            <div class="bc-body">
              <div class="cidx">01</div>
              <p class="bc-en">产业园与跨境平台</p>
              <h3 class="bc-name">产业园与跨境平台</h3>
              <p class="bc-text">关丹数字清真食品产业园：格宾 730 英亩 + 甘孟 100 英亩，合计 830 英亩。一站式平台：注册入驻、JAKIM 清真认证、物流配套与市场渠道。</p>
              <div class="bc-tags"><span>清真产业园</span><span>JAKIM 认证</span><span>跨境平台</span></div>
              <span class="bc-arr">了解更多 →</span>
            </div>
          </div>

          <div class="bc cbar" onclick="location.href='/zh/business#logistics'">
            <div class="bc-img"><img src="/images/common/business/b2.png" alt="物流" loading="lazy" /></div>
            <div class="bc-body">
              <div class="cidx">02</div>
              <p class="bc-en">物流与供应链</p>
              <h3 class="bc-name">物流与供应链</h3>
              <p class="bc-text">丰捷物流深耕印度尼西亚与马来西亚——整合仓储、运输、冷链及跨境供应链，助力企业快速进入东南亚市场。</p>
              <div class="bc-tags"><span>冷链物流</span><span>仓储配送</span><span>东南亚</span></div>
              <span class="bc-arr">了解更多 →</span>
            </div>
          </div>

          <div class="bc cbar" onclick="location.href='/zh/business#healthcare'">
            <div class="bc-img"><img src="/images/common/business/b3-new.png" alt="医疗康养" loading="lazy" /></div>
            <div class="bc-body">
              <div class="cidx">03</div>
              <p class="bc-en">医疗与康养</p>
              <h3 class="bc-name">医疗与康养</h3>
              <p class="bc-text">功能性农业、保健食品、康养体验及马来西亚血液透析中心——将农业延伸至健康生活管理领域。</p>
              <div class="bc-tags"><span>功能食品</span><span>血透中心</span><span>康养</span></div>
              <span class="bc-arr">了解更多 →</span>
            </div>
          </div>

          <div class="bc cbar" onclick="location.href='/zh/business#trade'">
            <div class="bc-img"><img src="/images/common/business/b4-new.png" alt="贸易" loading="lazy" /></div>
            <div class="bc-body">
              <div class="cidx">04</div>
              <p class="bc-en">贸易与分销</p>
              <h3 class="bc-name">贸易与分销</h3>
              <p class="bc-text">全球采购、跨境流通与区域分销——高效开拓东盟及国际市场，助力农产品与食品走向世界。</p>
              <div class="bc-tags"><span>清真进出口</span><span>分销渠道</span><span>全球采购</span></div>
              <span class="bc-arr">了解更多 →</span>
            </div>
          </div>

          <div class="bc cbar" onclick="location.href='/zh/business#agriculture'">
            <div class="bc-img"><img src="/images/common/business/b5.png" alt="农业" loading="lazy" /></div>
            <div class="bc-body">
              <div class="cidx">05</div>
              <p class="bc-en">农业与生态科技</p>
              <h3 class="bc-name">农业与生态科技</h3>
              <p class="bc-text">现代肉鸡养殖、生态循环农业与 EnzyLoop 酶联生态系统——构建更健康、更安全、更可持续的农业基础。</p>
              <div class="bc-tags"><span>肉鸡养殖</span><span>EnzyLoop</span><span>可持续农业</span></div>
              <span class="bc-arr">了解更多 →</span>
            </div>
          </div>

          <div class="bc cbar" onclick="location.href='/zh/business#digital'">
            <div class="bc-img"><img src="/images/common/business/b6-new.png" alt="数字系统" loading="lazy" /></div>
            <div class="bc-body">
              <div class="cidx">06</div>
              <p class="bc-en">数字系统</p>
              <h3 class="bc-name">数字系统</h3>
              <p class="bc-text">人工智能、物联网、区块链及农业、物流、供应链全链路数字平台——提升运营效率与各环节协同能力。</p>
              <div class="bc-tags"><span>人工智能</span><span>物联网</span><span>区块链</span></div>
              <span class="bc-arr">了解更多 →</span>
            </div>
          </div>

        </div>
        <div class="reveal d2" style="margin-top:36px">
          <a href="/zh/business" class="btn btn--ghost">探索全部业务板块 →</a>
        </div>
      </div>
    </section>

    <!-- ══ 旗舰项目 ══ -->
    <section class="section proj-sec" id="projects">
      <div class="wrap">
        <div class="reveal">
          <div class="label">旗舰项目</div>
          <h2>战略落地，<em>务实推进</em>。</h2>
          <p class="body-text">丰麒集团在中国、马来西亚和印度尼西亚推进的核心项目——助力企业落地注册、认证通关、物流配送与市场拓展。</p>
        </div>
        <div class="proj-grid">
          {projects.map(p => {
            const zh = ZH_PROJECTS[p.slug]
            return (
              <a href={`/zh/projects/${p.slug}`} class="pc">
                <div class="pc-img">
                  <img src={p.data.order === 4 ? "/images/common/projects/c4-new.png" : `/images/common/projects/c${p.data.order}.png`} alt={zh?.title ?? p.data.title} loading="lazy" />
                  <div class="pc-overlay">
                    <span class="pc-cat">{p.data.category}</span>
                    <span class="pc-status">{p.data.status === 'Active' ? '✓ 运营中' : p.data.status === 'In Development' ? '⬤ 开发中' : '◯ 规划中'}</span>
                  </div>
                </div>
                <div class="pc-body">
                  <h3 class="pc-title">{zh?.title ?? p.data.title}</h3>
                  <p class="pc-sub">{zh?.subtitle ?? p.data.subtitle}</p>
                  <p class="pc-loc">📍 {p.data.location}</p>
                  <ul class="pc-hl">
                    {(zh?.highlights ?? p.data.highlights).slice(0,3).map(h => <li>{h}</li>)}
                  </ul>
                  <span class="pc-arr">查看项目详情 →</span>
                </div>
              </a>
            )
          })}
        </div>
        <div class="reveal d2" style="margin-top:36px">
          <a href="/zh/projects" class="btn btn--ghost">全部项目 →</a>
        </div>
      </div>
    </section>

    <!-- ══ 全球布局 ══ -->
    <section class="section mc-sec" id="global-footprint">
      <div class="wrap">
        <div class="reveal">
          <div class="label">全球布局</div>
          <h2>三大战略区域，<em>一个</em>互联平台。</h2>
          <p class="body-text">
            丰麒以中国为产业基地，以马来西亚为东南亚核心枢纽，并持续拓展印度尼西亚市场——构建覆盖生产、物流、贸易与产业协同的跨境网络。
          </p>
        </div>
        <div class="mc-grid">
          {[
            { flag:'🇨🇳', region:'中国', role:'产业基地与科技创新', hl:false,
              items:['农业生态科技与数字系统','增城 530 英亩生态农业示范基地','肉鸡养殖、功能性食品与保健产品','供应链整合与跨境出口'],
              stat:'生产与科技核心',
              img:'/images/common/a1-new.png' },
            { flag:'🇲🇾', region:'马来西亚', role:'东盟枢纽与清真通道', hl:true,
              items:['关丹数字清真产业园：格宾 730 + 甘孟 100 英亩','JAKIM 清真认证，覆盖 80+ 国家','关丹港 + 东海岸铁路（ECRL）接入','RCEP 及马来西亚-欧盟自贸协定关税优势'],
              stat:'全球清真市场通道',
              img:'https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=800&q=80' },
            { flag:'🇮🇩', region:'印度尼西亚', role:'区域物流网络', hl:false,
              items:['丰捷物流：4 个仓储配送中心遍布爪哇','覆盖约 80% 爪哇物流需求','触达约 1.45 亿核心经济区人口','冷链、城市配送与干线运输'],
              stat:'触达 1.45 亿人口',
              img:'/images/common/a3-new.png' },
          ].map((n, i) => (
            <div class={`mc-card reveal d${i+1}${n.hl?' mc-card--hl':''}`}>
              <div class="mc-img">
                <img src={n.img} alt={n.region} loading="lazy" />
                <div class="mc-img-badge">{n.flag} {n.region}</div>
              </div>
              <div class="mc-body">
                <h3 class="mc-role">{n.role}</h3>
                <ul class="mc-items">
                  {n.items.map(item => <li>{item}</li>)}
                </ul>
                <p class="mc-stat">{n.stat}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mc-corridors reveal d2">
          {[
            { lbl:'通道一', text:'中国产品 → 马来西亚 JAKIM 清真认证 → 东盟及中东市场' },
            { lbl:'通道二', text:'中国供应链 → 丰捷物流印度尼西亚 → 爪哇岛配送'        },
            { lbl:'通道三', text:'跨境贸易 → 马来西亚枢纽 → 非洲及全球穆斯林市场'       },
          ].map(c => (
            <div class="mc-cor">
              <span class="mc-cor-lbl">{c.lbl}</span>
              <p class="mc-cor-txt">{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ 最新动态 ══ -->
    {latest.length > 0 && (
      <section class="section ins-sec" id="insights">
        <div class="wrap">
          <div class="reveal">
            <div class="label">最新动态</div>
            <h2>新闻与<em>资讯</em>。</h2>
          </div>
          <div class="ins-grid">
            {latest.map((a, i) => {
              const imgSrc = a.image ?? DEFAULT_NEWS_IMG
              return (
                <a href={`/zh/insights/${a.slug}`} class={`ins-card reveal d${i+1}`}>
                  <div class="ins-card-img">
                    <img src={imgSrc} alt={a.title} loading="lazy" />
                    <span class="ins-card-cat">{a.category}</span>
                  </div>
                  <div class="ins-card-body">
                    <p class="ins-card-date">{a.date.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}</p>
                    <h3 class="ins-card-title">{a.title}</h3>
                    <p class="ins-card-sum">{a.summary}</p>
                    <span class="ins-card-arr">阅读全文 →</span>
                  </div>
                </a>
              )
            })}
          </div>
          <div class="reveal d2" style="margin-top:36px">
            <a href="/zh/insights" class="btn btn--ghost">全部动态 →</a>
          </div>
        </div>
      </section>
    )}

    <!-- ══ CTA ══ -->
    <section class="section cta-sec" id="cta">
      <div class="geo-bg geo-bg--fade" style="opacity:.3"></div>
      <div class="wrap cta-wrap">
        <div class="label reveal">开放合作</div>
        <h2 class="reveal d1">携手共建<em>中国与东南亚</em>产业未来。</h2>
        <p class="body-text reveal d2">丰麒诚邀政府机构、企业伙伴、投资方及渠道合作商，共同推进区域产业发展、供应链建设与市场开拓。</p>
        <div class="cta-acts reveal d3">
          <a href="/zh/partnership" class="btn btn--gold">探索合作机会</a>
          <a href="/zh/contact"     class="btn btn--ghost">联系我们</a>
        </div>
      </div>
    </section>

  </main>

  <Footer lang="zh" />

  <ClientEffects />
</BaseLayout>

<style>
/* ══ Hero ══ */
.hero { min-height:100vh; display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden; background:var(--bg); padding-top:80px; }
.hero-bg { position:absolute; inset:0; pointer-events:none; background:linear-gradient(135deg,rgba(184,145,42,.05) 0%,transparent 55%),linear-gradient(225deg,rgba(184,145,42,.03) 0%,transparent 45%); }
.hero-content { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:60px; padding-top:60px; padding-bottom:120px; position:relative; z-index:2; }
.hero-over { font-family:var(--FL); font-size:22px; letter-spacing:5px; color:var(--gold); margin-bottom:24px; display:flex; align-items:center; gap:14px; opacity:0; animation:slideRight .9s ease .15s forwards; }
.hero-over::before { content:''; width:28px; height:1.5px; background:var(--gold); flex-shrink:0; }
.hero-h1 { margin-bottom:24px; font-weight:400; opacity:0; animation:slideRight .9s ease .3s forwards; }
.hero-h1 em { font-family:var(--FD); color:var(--gold); font-style:italic; font-weight:300; }
.hero-body { font-family:var(--FB); font-size:16px; font-weight:400; line-height:1.85; color:var(--text-2); max-width:520px; margin-bottom:36px; opacity:0; animation:slideRight .9s ease .45s forwards; }
.hero-actions { display:flex; gap:16px; flex-wrap:wrap; opacity:0; animation:slideRight .9s ease .6s forwards; }

/* 右侧业务卡 */
.hero-right { display:flex; align-items:center; justify-content:center; opacity:0; animation:fadeIn 1s ease .75s forwards; }
.hero-segs { display:grid; grid-template-columns:1fr 1fr; gap:10px; width:100%; max-width:420px; }
.hseg { display:flex; align-items:flex-start; gap:10px; padding:18px 16px; background:var(--bg); border:1px solid var(--bg-4); border-left:3px solid transparent; text-decoration:none; color:inherit; transition:border-color .25s,box-shadow .25s,background .25s; opacity:0; }
.anim-d0{animation:fadeIn .6s ease .85s forwards}.anim-d1{animation:fadeIn .6s ease .95s forwards}
.anim-d2{animation:fadeIn .6s ease 1.05s forwards}.anim-d3{animation:fadeIn .6s ease 1.15s forwards}
.anim-d4{animation:fadeIn .6s ease 1.25s forwards}.anim-d5{animation:fadeIn .6s ease 1.35s forwards}
