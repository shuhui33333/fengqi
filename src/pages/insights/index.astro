---
// src/pages/insights/index.astro  →  /insights  (All, page 1 of paginated list)
import BaseLayout    from '../../layouts/BaseLayout.astro'
import Header        from '../../components/Header.astro'
import Footer        from '../../components/Footer.astro'
import ClientEffects from '../../components/ClientEffects.astro'
import Pagination    from '../../components/ui/Pagination.astro'
import CategoryTabs  from '../../components/insights/CategoryTabs.astro'
import InsightsGrid  from '../../components/insights/InsightsGrid.astro'
import { getAllInsights } from '../../lib/storyblok'

const PER_PAGE = 9
const all   = await getAllInsights()
const posts = all.slice(0, PER_PAGE)
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE))
---
<BaseLayout title="Insights | Fengqi Group" description="Latest news, project updates and industry perspectives from Fengqi Group.">
  <Header active="/insights" />
  <main>

    <!-- ── Page Hero — same style as all other interior pages ── -->
    <section class="section ins-hero page-hero">
      <div class="wrap">
        <div class="ins-hero-content">
          <div class="label">Insights</div>
          <h1>News &amp; <em>Updates</em>.</h1>
          <p class="body-text body-text--wide">
            Latest developments, project milestones and industry perspectives from Fengqi Group.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Article Grid ── -->
    <section class="section sec-light" id="all-insights">
      <div class="wrap">
        <CategoryTabs lang="en" active="all" />
        <InsightsGrid
          posts={posts}
          lang="en"
          basePath="/insights"
          emptyText="No articles published yet — check back soon."
        />
        <Pagination currentPage={1} totalPages={totalPages} basePath="/insights" />
      </div>
    </section>

  </main>
  <Footer />
  <ClientEffects />
</BaseLayout>

<style>
/* ── Hero — same visual weight as other interior pages ── */
.ins-hero { /* .page-hero provides background + border via global.css */ }
.ins-hero-content { max-width: 760px; }
.ins-hero h1   { color: var(--text); }
.ins-hero h1 em { color: var(--gold); }
.ins-hero .label { color: var(--gold); }
.ins-hero .body-text { color: var(--text-2); }
</style>
