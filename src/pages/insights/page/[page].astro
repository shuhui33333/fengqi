---
// src/pages/insights/page/[page].astro  →  /insights/page/2, /insights/page/3 …
// Page 1 lives at /insights (index.astro); this route covers pages 2+.
import BaseLayout    from '../../../layouts/BaseLayout.astro'
import Header        from '../../../components/Header.astro'
import Footer        from '../../../components/Footer.astro'
import ClientEffects from '../../../components/ClientEffects.astro'
import Pagination    from '../../../components/ui/Pagination.astro'
import CategoryTabs  from '../../../components/insights/CategoryTabs.astro'
import InsightsGrid  from '../../../components/insights/InsightsGrid.astro'
import { getAllInsights } from '../../../lib/storyblok'

export async function getStaticPaths() {
  const PER_PAGE = 9
  const all = await getAllInsights()
  const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE))

  // Generate routes for pages 2 … N (page 1 is /insights)
  const paths = []
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props:  {
        pagePosts: all.slice((p - 1) * PER_PAGE, p * PER_PAGE),
        currentPage: p,
        totalPages,
      },
    })
  }
  return paths
}

const { pagePosts, currentPage, totalPages } = Astro.props
---
<BaseLayout title={`Insights — Page ${currentPage} | Fengqi Group`} description="Latest news, project updates and industry perspectives from Fengqi Group.">
  <Header active="/insights" />
  <main>

    <section class="section ins-hero page-hero">
      <div class="wrap">
        <div class="ins-hero-content">
          <div class="label">Insights</div>
          <h1>News &amp; <em>Updates</em>.</h1>
          <p class="body-text body-text--wide">
            Latest developments, project milestones and industry perspectives from Fengqi Group.
          </p>
        </div>
      </div>
    </section>

    <section class="section sec-light" id="all-insights">
      <div class="wrap">
        <CategoryTabs lang="en" active="all" />
        <InsightsGrid
          posts={pagePosts}
          lang="en"
          basePath="/insights"
          emptyText="No articles published yet — check back soon."
        />
        <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/insights" />
      </div>
    </section>

  </main>
  <Footer />
  <ClientEffects />
</BaseLayout>

<style>
.ins-hero { }
.ins-hero-content { max-width: 760px; }
.ins-hero h1   { color: var(--text); }
.ins-hero h1 em { color: var(--gold); }
.ins-hero .label { color: var(--gold); }
.ins-hero .body-text { color: var(--text-2); }
</style>
