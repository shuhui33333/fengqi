---
// src/pages/insights/official/page/[page].astro  →  /insights/official/page/2 …
import BaseLayout    from '../../../../layouts/BaseLayout.astro'
import Header        from '../../../../components/Header.astro'
import Footer        from '../../../../components/Footer.astro'
import ClientEffects from '../../../../components/ClientEffects.astro'
import Pagination    from '../../../../components/ui/Pagination.astro'
import CategoryTabs  from '../../../../components/insights/CategoryTabs.astro'
import InsightsGrid  from '../../../../components/insights/InsightsGrid.astro'
import { getAllInsights } from '../../../../lib/storyblok'

export async function getStaticPaths() {
  const PER_PAGE = 9
  const all = await getAllInsights('official')
  const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE))
  const paths = []
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props:  {
        pagePosts: all.slice((p - 1) * PER_PAGE, p * PER_PAGE),
        currentPage: p,
        totalPages,
      },
    })
  }
  return paths
}

const { pagePosts, currentPage, totalPages } = Astro.props
---
<BaseLayout title={`Official News — Page ${currentPage} | Fengqi Group`} description="Official announcements and company updates from Fengqi Group.">
  <Header active="/insights" />
  <main>

    <section class="section ins-hero page-hero">
      <div class="wrap">
        <div class="ins-hero-content">
          <div class="label">Insights</div>
          <h1>Official <em>News</em>.</h1>
          <p class="body-text body-text--wide">Official announcements and company updates from Fengqi Group.</p>
        </div>
      </div>
    </section>

    <section class="section sec-light" id="all-insights">
      <div class="wrap">
        <CategoryTabs lang="en" active="official" />
        <InsightsGrid
          posts={pagePosts}
          lang="en"
          basePath="/insights"
          emptyText="No official news published yet — check back soon."
        />
        <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/insights/official" />
      </div>
    </section>

  </main>
  <Footer />
  <ClientEffects />
</BaseLayout>

<style>
.ins-hero-content { max-width: 760px; }
.ins-hero h1   { color: var(--text); }
.ins-hero h1 em { color: var(--gold); }
.ins-hero .label { color: var(--gold); }
.ins-hero .body-text { color: var(--text-2); }
</style>
