---
// src/pages/insights/media/index.astro  →  /insights/media  (page 1)
import BaseLayout    from '../../../layouts/BaseLayout.astro'
import Header        from '../../../components/Header.astro'
import Footer        from '../../../components/Footer.astro'
import ClientEffects from '../../../components/ClientEffects.astro'
import Pagination    from '../../../components/ui/Pagination.astro'
import CategoryTabs  from '../../../components/insights/CategoryTabs.astro'
import InsightsGrid  from '../../../components/insights/InsightsGrid.astro'
import { getAllInsights } from '../../../lib/storyblok'

const PER_PAGE = 9
const all   = await getAllInsights('media')
const posts = all.slice(0, PER_PAGE)
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE))
---
<BaseLayout title="Media Coverage | Fengqi Group" description="Press mentions and third-party media coverage of Fengqi Group.">
  <Header active="/insights" />
  <main>

    <section class="section ins-hero page-hero">
      <div class="wrap">
        <div class="ins-hero-content">
          <div class="label">Insights</div>
          <h1>Media <em>Coverage</em>.</h1>
          <p class="body-text body-text--wide">
            Press mentions and third-party media coverage of Fengqi Group.
          </p>
        </div>
      </div>
    </section>

    <section class="section sec-light" id="all-insights">
      <div class="wrap">
        <CategoryTabs lang="en" active="media" />
        <InsightsGrid
          posts={posts}
          lang="en"
          basePath="/insights"
          emptyText="No media coverage published yet — check back soon."
        />
        <Pagination currentPage={1} totalPages={totalPages} basePath="/insights/media" />
      </div>
    </section>

  </main>
  <Footer />
  <ClientEffects />
</BaseLayout>

<style>
.ins-hero-content { max-width: 760px; }
.ins-hero h1   { color: var(--text); }
.ins-hero h1 em { color: var(--gold); }
.ins-hero .label { color: var(--gold); }
.ins-hero .body-text { color: var(--text-2); }
</style>
