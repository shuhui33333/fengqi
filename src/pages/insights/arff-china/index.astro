---
// src/pages/insights/arff-china/index.astro  →  /insights/arff-china  (page 1)
import BaseLayout    from '../../../layouts/BaseLayout.astro'
import Header        from '../../../components/Header.astro'
import Footer        from '../../../components/Footer.astro'
import ClientEffects from '../../../components/ClientEffects.astro'
import Pagination    from '../../../components/ui/Pagination.astro'
import CategoryTabs  from '../../../components/insights/CategoryTabs.astro'
import InsightsGrid  from '../../../components/insights/InsightsGrid.astro'
import { getAllInsights } from '../../../lib/storyblok'

const PER_PAGE = 9
const all   = await getAllInsights('arff-china')
const posts = all.slice(0, PER_PAGE)
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE))
---
<BaseLayout title="ARFF China | Fengqi Group" description="Updates from ARFF's operations and partnerships in China.">
  <Header active="/insights" />
  <main>

    <section class="section ins-hero page-hero">
      <div class="wrap">
        <div class="ins-hero-content">
          <div class="label">Insights</div>
          <h1>ARFF <em>China</em>.</h1>
          <p class="body-text body-text--wide">
            Updates from ARFF's operations and partnerships in China.
          </p>
        </div>
      </div>
    </section>

    <section class="section sec-light" id="all-insights">
      <div class="wrap">
        <CategoryTabs lang="en" active="arff-china" />
        <InsightsGrid
          posts={posts}
          lang="en"
          basePath="/insights"
          emptyText="No ARFF China updates published yet — check back soon."
        />
        <Pagination currentPage={1} totalPages={totalPages} basePath="/insights/arff-china" />
      </div>
    </section>

  </main>
  <Footer />
  <ClientEffects />
</BaseLayout>

<style>
.ins-hero-content { max-width: 760px; }
.ins-hero h1   { color: var(--text); }
.ins-hero h1 em { color: var(--gold); }
.ins-hero .label { color: var(--gold); }
.ins-hero .body-text { color: var(--text-2); }
</style>
